# /etc/kasa/kasa.env - sekrety kasy na serwerze (chmod 600, właściciel root:kasa). Nigdy w repo.
# Wartości wpisz ręcznie; plik czytają usługi systemd i skrypt kasa-bank.sh.

# Baza: Supabase, projekt odm (Session pooler, port 5432). Hasło z panelu Supabase: Project Settings → Database.
KASA_DATABASE_URL=postgresql://postgres.wxdpjdymlbgnjdqkvrnd:HASLO@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Pseudonimizacja: TEN SAM sekret co dotąd (inny = inne kody i brak odczytu starych wartości).
KASA_PSEUDONYM_SECRET=

# EnableBanking: aplikacja „ODM Partners - wyciagi”.
KASA_BANK_PROVIDER=enablebanking
KASA_EB_APP_ID=
# Klucz prywatny aplikacji jako plik (chmod 600, właściciel kasa) - wygodniej niż PEM w jednej linii.
KASA_EB_PRIVATE_KEY_PATH=/etc/kasa/enablebanking.pem
# Sesje (zgody) bankowe: nazwa=session_id, oddzielone spacją. Nowa zgoda co 180 dni → podmień identyfikator.
KASA_EB_SESSIONS="mbank=SESSION_ID_MBANKU millennium=SESSION_ID_MILLENNIUM"

# Reszta dostawców na razie na danych testowych.
KASA_KSEF_PROVIDER=mock
KASA_LLM_PROVIDER=mock

# Katalog roboczy kasy (pliki pomocnicze, sekrety z panelu /settings).
KASA_HOME=/var/lib/kasa
